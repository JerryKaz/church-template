# ── Front end (Vite) ─────────────────────────────────────────────
# Leave unset to run fully in the browser (localStorage demo mode).
# "/" = same origin (Vite dev proxy, or the Express server hosting the build).
# Or a full URL if the API lives elsewhere, e.g. https://api.yourchurch.org
VITE_API_URL=/

# ── API server (Express) ─────────────────────────────────────────
PORT=3001
# Comma-separated origins allowed to call the API from another domain.
CORS_ORIGIN=http://localhost:5173
# Enables /api/admin/* (submissions, prayer moderation). Use a long random string.
ADMIN_TOKEN=
# Where db.json is stored (defaults to server/data).
DATA_DIR=
